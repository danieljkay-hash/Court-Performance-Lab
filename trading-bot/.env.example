# Alpaca API credentials. Get them at https://app.alpaca.markets/
# Paper keys are free and require no funding — start here.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# "paper" (default, simulated money) or "live" (REAL money).
# Leave as paper until your strategy has proven itself in backtest + paper.
TRADING_MODE=paper

# --- Risk controls (all fractions are 0..1) ---
# Max fraction of total equity to put in a single position.
MAX_POSITION_PCT=0.10
# Per-trade stop loss, as a fraction below entry price.
STOP_LOSS_PCT=0.05
# Max number of concurrent open positions.
MAX_OPEN_POSITIONS=5
# Halt new entries for the day if equity drops this fraction from day's start.
MAX_DAILY_LOSS_PCT=0.03

# --- Strategy parameters ---
FAST_MA=20
SLOW_MA=50
# Bar timeframe for signals: 1Min, 5Min, 15Min, 1Hour, 1Day
TIMEFRAME=1Day
# Seconds between run-loop iterations in live/paper mode.
POLL_SECONDS=60
